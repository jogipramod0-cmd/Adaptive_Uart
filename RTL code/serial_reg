`timescale 1ns/1ps

module serial_reg(
    input clk,
    input rst,
    input serial_in,
    input enable,
    output reg [7:0] data_out,
    output reg done
);

reg [2:0] count;

always @(posedge clk or posedge rst) begin

    if (rst) begin
        data_out <= 8'b0;
        count <= 3'b0;
        done <= 1'b0;
    end

    else begin

        done <= 1'b0;

        if (enable) begin

            data_out <= {data_out[6:0], serial_in};

            if (count == 3'd7) begin
                count <= 3'b0;
                done <= 1'b1;
            end

            else begin
                count <= count + 1'b1;
            end

        end

    end

end

endmodule
