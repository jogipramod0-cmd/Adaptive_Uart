`timescale 1ns/1ps

module uart_tx #(
    parameter CLKS_PER_BIT = 4
)(
    input clk,
    input rst,
    input start,
    input [7:0] data_in,
    output reg tx,
    output reg busy
);

localparam IDLE  = 2'd0;
localparam START = 2'd1;
localparam DATA  = 2'd2;
localparam STOP  = 2'd3;

reg [1:0] state;
reg [7:0] data_reg;
reg [2:0] bit_count;
reg [15:0] clk_count;

always @(posedge clk or posedge rst) begin

    if (rst) begin
        state <= IDLE;
        data_reg <= 8'b0;
        bit_count <= 3'b0;
        clk_count <= 16'b0;
        tx <= 1'b1;
        busy <= 1'b0;
    end

    else begin

        case (state)

            IDLE: begin

                tx <= 1'b1;
                busy <= 1'b0;
                clk_count <= 0;
                bit_count <= 0;

                if (start) begin
                    data_reg <= data_in;
                    busy <= 1'b1;
                    state <= START;
                end

            end

            START: begin

                tx <= 1'b0;

                if (clk_count == CLKS_PER_BIT-1) begin
                    clk_count <= 0;
                    state <= DATA;
                end

                else
                    clk_count <= clk_count + 1'b1;

            end

            DATA: begin

                tx <= data_reg[bit_count];

                if (clk_count == CLKS_PER_BIT-1) begin

                    clk_count <= 0;

                    if (bit_count == 3'd7) begin
                        bit_count <= 0;
                        state <= STOP;
                    end

                    else
                        bit_count <= bit_count + 1'b1;

                end

                else
                    clk_count <= clk_count + 1'b1;

            end

            STOP: begin

                tx <= 1'b1;

                if (clk_count == CLKS_PER_BIT-1) begin
                    clk_count <= 0;
                    busy <= 1'b0;
                    state <= IDLE;
                end

                else
                    clk_count <= clk_count + 1'b1;

            end

        endcase

    end

end

endmodule
