`timescale 1ns/1ps

module mode_detector(
    input clk,
    input rst,
    input [7:0] parallel_in,
    input serial_in,

    output reg detected_mode,
    output reg mode_valid
);

reg [7:0] previous_parallel;
integer change_count;
integer i;

always @(posedge clk or posedge rst) begin

    if (rst) begin
        previous_parallel <= 8'b0;
        detected_mode <= 1'b0;
        mode_valid <= 1'b0;
    end

    else begin

        change_count = 0;

        for (i = 0; i < 8; i = i + 1) begin
            if (parallel_in[i] != previous_parallel[i])
                change_count = change_count + 1;
        end

        mode_valid <= 1'b0;

        if (change_count >= 2) begin
            detected_mode <= 1'b0;
            mode_valid <= 1'b1;
        end

        else if (change_count == 1) begin
            detected_mode <= 1'b1;
            mode_valid <= 1'b1;
        end

        previous_parallel <= parallel_in;

    end

end

endmodule
