module universal_tx #(
    parameter CLKS_PER_BIT = 4
)(
    input clk,
    input rst,

    input [7:0] parallel_in,
    input serial_in,

    input mode_select,
    input send,

    output tx,
    output busy
);

    wire [7:0] parallel_reg_data;
    wire [7:0] serial_reg_data;

    wire parallel_load;

    wire serial_enable;
    wire serial_done;

    wire detected_mode;
    wire mode_valid;

    wire [7:0] mux_data;

    reg [2:0] serial_count;
    reg serial_collect;

    reg [7:0] uart_data;
    reg uart_start;

    reg [1:0] state;

    localparam IDLE = 2'd0;
    localparam LOAD = 2'd1;
    localparam SEND = 2'd2;

parallel_reg parallel_reg_inst (
        .clk(clk),
        .rst(rst),
        .load(parallel_load),
        .data_in(parallel_in),
        .data_out(parallel_reg_data)
    );
    serial_reg serial_reg_inst (
        .clk(clk),
        .rst(rst),
        .serial_in(serial_in),
        .enable(serial_enable),
        .data_out(serial_reg_data),
        .done(serial_done)
    );


    // =========================================================
    // Mode detector
    // =========================================================

    mode_detector mode_detector_inst (
        .clk(clk),
        .rst(rst),
        .parallel_in(parallel_in),
        .serial_in(serial_in),
        .detected_mode(detected_mode),
        .mode_valid(mode_valid)
    );


    tx_data_mux tx_data_mux_inst (
        .parallel_data(parallel_reg_data),
        .serial_data(serial_reg_data),
        .mode_select(mode_select),
        .data_out(mux_data)
    );

    uart_tx #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) UART_TX (
        .clk(clk),
        .rst(rst),
        .start(uart_start),
        .data_in(uart_data),
        .tx(tx),
        .busy(busy)
    );


    assign parallel_load = (!mode_select && send && !busy);

    assign serial_enable = (mode_select && serial_collect);

    always @(posedge clk or posedge rst) begin

        if (rst) begin

            serial_count  <= 3'd0;
            serial_collect <= 1'b0;

            uart_data  <= 8'b0;
            uart_start <= 1'b0;

            state <= IDLE;

        end

        else begin

            // Default
            uart_start <= 1'b0;

            if (mode_select && send && !busy && !serial_collect) begin

                serial_count   <= 3'd1;
                serial_collect <= 1'b1;

            end

            else if (mode_select && serial_collect) begin

                if (serial_count == 3'd7) begin

                    serial_collect <= 1'b0;
                    serial_count   <= 3'd0;
                    state          <= LOAD;

                end

                else begin

                    serial_count <= serial_count + 1'b1;

                end

            end
            case (state)

                IDLE: begin

                    if (!mode_select && send && !busy)
                        state <= LOAD;

                end


                LOAD: begin

                    if (!busy) begin

                        uart_data <= mux_data;
                        state <= SEND;

                    end

                end


                SEND: begin

                    if (!busy) begin

                        uart_start <= 1'b1;
                        state <= IDLE;

                    end

                end


                default: begin

                    state <= IDLE;

                end

            endcase

        end

    end

endmodule
